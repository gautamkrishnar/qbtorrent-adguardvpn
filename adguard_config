#!/bin/bash
source /functions.sh

# The project sends all container traffic through the VPN. Apply these on every
# start so old or changed persisted CLI settings cannot bypass the tunnel.
if ! adguardvpn-cli config set-mode TUN || \
   ! adguardvpn-cli config set-tun-routing-mode AUTO || \
   ! adguardvpn-cli config set-change-system-dns on; then
  echo "Unable to configure AdGuard VPN TUN routing; requesting graceful container restart..."
  kill -TERM 1
  exit 0
fi

VPN_STATUS=$(adguardvpn-cli status 2>&1 | head -n 1)
if [[ "$VPN_STATUS" == *"not logged in"* ]] || [[ "$VPN_STATUS" == *"Please log in"* ]]; then
  if [[ ${ADGUARD_USERNAME+x} && ${ADGUARD_PASSWORD+x} ]]; then
    adguardvpn-cli login -u "$ADGUARD_USERNAME" -p "$ADGUARD_PASSWORD"
  fi
fi

VPN_STATUS=$(adguardvpn-cli status 2>&1 | head -n 1)
if [[ "$VPN_STATUS" != "VPN is disconnected" ]]; then
  adguardvpn-cli disconnect
  sleep 5
  VPN_STATUS=$(adguardvpn-cli status 2>&1 | head -n 1)
  if [[ "$VPN_STATUS" != "VPN is disconnected" ]]; then
    echo "NOT DISCONNECTED AFTER DISCONNECT - THIS SHOULD NOT HAPPEN!!!"
    echo "Requesting graceful container shutdown..."
    kill -TERM 1
    exit 0
  fi
fi

HOST_IP=$(get_ip)
write_var "HOST_IP" "$HOST_IP"

if [[ ${ADGUARD_LOCATION+x} && -n "$ADGUARD_LOCATION" ]]; then
  adguardvpn-cli connect -y -4 -l "$ADGUARD_LOCATION" &
else
  adguardvpn-cli connect -y -4 -f &
fi

VPN_CONNECTED=0
for ((attempt = 0; attempt < 30; attempt++)); do
  VPN_STATUS=$(adguardvpn-cli status 2>&1 | head -n 1)
  if [[ "$VPN_STATUS" =~ ^Connected\ to\ .* ]]; then
    VPN_CONNECTED=1
    break
  fi
  sleep 1
done

if [[ "$VPN_CONNECTED" -ne 1 ]]; then
  echo "Unable to connect to VPN; requesting graceful container restart..."
  kill -TERM 1
  exit 0
fi

VPN_IP=$(get_ip)
write_var "VPN_IP" "$VPN_IP"

if [[ -z "$HOST_IP" || -z "$VPN_IP" || "$HOST_IP" == "$VPN_IP" ]]; then
  echo "Public IP check failed or VPN IP matches the host IP."
  echo "Requesting graceful container restart..."
  kill -TERM 1
  exit 0
fi
