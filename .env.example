# AdGuard VPN credentials
ADGUARD_USERNAME=your-email@example.com
ADGUARD_PASSWORD=your-password

# VPN location (city name, country, or ISO code). Leave empty for fastest server.
ADGUARD_LOCATION=

# Disable telemetry
ADGUARD_SEND_REPORTS=off

# Downloads path on the host
DOWNLOADS_PATH=/path/to/downloads

# Container user/group IDs (use `id` command to find yours)
PUID=1000
PGID=1000

# Timezone
TZ=UTC

# qBittorrent credentials (used by cronjob to auto-resume errored torrents)
QBT_USERNAME=admin
QBT_PASSWORD=your-qbittorrent-password

# Reverse proxy settings (optional)
# VIRTUAL_HOST=torrent.example.com
# VIRTUAL_PORT=8080
